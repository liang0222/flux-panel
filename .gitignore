# 部署发布包：忽略打包产物与其中的二进制，
# 但保留 deploy-*.sh / docker-compose.yml / README.md 等脚本源码以便维护
/release/*.zip
/release/flux-panel-docker/binaries/
/release/flux-panel-docker/springboot-backend/
/release/flux-panel-docker/vite-frontend/

# ==========================================
# 客户端（iOS / Android WebView 壳）注入产物
# ==========================================
# 这些文件由 scripts/inject-client-assets.ps1 从 vite-frontend/dist-client 注入，
# 带内容哈希、体积较大（主包约 7MB），不应纳入版本控制。
# 重新打包客户端前，先执行：
#   cd vite-frontend && npm run build:client
#   powershell -ExecutionPolicy Bypass -File ./scripts/inject-client-assets.ps1
/android-app/app/src/main/assets/
/ios-app/flux/index.html
/ios-app/flux/index-*.js
/ios-app/flux/index-*.css
/ios-app/flux/vite.svg
/ios-app/flux/favicon-*.ico
/ios-app/flux/bg-*.jpg

