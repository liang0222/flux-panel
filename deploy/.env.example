# 复制为 .env 并限制权限为 600。用 openssl rand -hex 32 生成随机密钥，再填入下方。
JWT_SECRET=
FRONTEND_PORT=6366
BACKEND_PORT=6365
# 默认只允许本机访问。希望外部节点直连时，显式填写后端服务的可信接口 IP。
FRONTEND_BIND_IP=127.0.0.1
BACKEND_BIND_IP=127.0.0.1
# 仅使用双栈 Compose 模板时生效。IPv6 地址不加方括号。
# FRONTEND_BIND_IPV6=::1
# BACKEND_BIND_IPV6=::1
# 使用 registry 模板时，可选用经过核验的 repo@sha256:... 部署镜像。
# FLUX_BACKEND_IMAGE=
# FLUX_FRONTEND_IMAGE=
# 同源网页无需配置。跨域客户端填写完整 Origin（按逗号分隔）；iOS 若实测发送 null 才显式添加 null。
# PANEL_ALLOWED_ORIGINS=https://panel.example.com
